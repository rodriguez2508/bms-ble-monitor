# Copy to .env and fill in your own values. Never commit the real .env.

# --- BMS / BLE ---
# Bluetooth MAC address of your BMS (required, no default).
BMS_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
# Modbus slave address of the BMS.
BMS_SLAVE_ADDR=1
# Seconds between BLE polls.
BMS_POLLING_INTERVAL=10

# --- Web server ---
FLASK_PORT=8000
FLASK_DEBUG=False
# Auto-reload the server on code changes (dev only; no interactive debugger).
FLASK_RELOAD=False

# --- Balance-cycle log (written by the server while polling) ---
BALANCE_LOG_ENABLED=true
BALANCE_LOG_INTERVAL=30
BALANCE_LOG_RETENTION_H=48
BALANCE_LOG_FILE=balance_cycle.csv

# --- Browser push alerts ---
# Contact subject for VAPID (mailto: or https: URL).
VAPID_SUBJECT=mailto:admin@localhost
# Low-SOC alert threshold and hysteresis (percentage points).
SOC_ALERT_PCT=10
SOC_ALERT_HYSTERESIS=5
# High-SOC alert threshold and hysteresis (percentage points).
SOC_HIGH_ALERT_PCT=95
SOC_HIGH_HYSTERESIS=5
# How often the alert watcher checks the latest reading (seconds).
ALERT_CHECK_INTERVAL=5
# Ignore readings older than this many seconds (seconds).
ALERT_STALE_SECONDS=60
# Send a push notification whenever the server (re)starts.
PUSH_ON_START=true
